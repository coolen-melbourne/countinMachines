<div id="product-list">
  {{#if products.length}}
  <div class="product-row" id="product-row">
    {{#each products}}
    <div class="product-card"
         data-id="{{_id}}"
         data-serial="{{serial}}"
         data-name="{{name}}"
         data-date="{{date}}"
         data-url="{{baseUrl}}/products/{{_id}}"
         data-rating="{{rating}}">

      <div class="image-wrapper">
        <img src="/uploads/{{image}}" alt="{{machineName}}">
      </div>

      <div class="product-info">
        <h3 style="color:#0a7cff;font-weight:bold;">№ {{@index}}</h3>
        <p>Seriya raqami: <span style="color:red;">{{serial}}</span></p>
        <p>Ro'yxatga oluvchi: <span style="color:red;">{{name}}</span></p>

        <!-- ⭐ RATING -->
        <div class="rating" data-id="{{_id}}">
          <span class="star {{#if (gte rating 1)}}active{{/if}}" data-star="1">★</span>
          <span class="star {{#if (gte rating 2)}}active{{/if}}" data-star="2">★</span>
          <span class="star {{#if (gte rating 3)}}active{{/if}}" data-star="3">★</span>
          <span class="star {{#if (gte rating 4)}}active{{/if}}" data-star="4">★</span>
          <span class="star {{#if (gte rating 5)}}active{{/if}}" data-star="5">★</span>
        </div>

        <div style="display:flex; gap:10px; margin-top:5px;">
          <button class="btn view-btn"><i class="fa-solid fa-print"></i> Print</button>

          {{#ifequal user ../userId}}
          <div style="display:flex; gap:10px;">
            <div class="comment" data-id="{{_id}}">
              <span class="comment-text">{{comment}}</span>
              <button class="edit-comment-btn"><i class="fa-regular fa-pen-to-square fa-fade"></i>Edit</button>
            </div>
            <form action="/products/delete/{{_id}}" method="post">
              <button class="btn delete-btn"><i class="fa-solid fa-trash-can fa-beat-fade"></i>Delete</button>
            </form>
          </div>
          {{/ifequal}}
        </div>

        <small>{{formatDate date}}</small>
      </div>
    </div>
    {{/each}}
  </div>
  {{else}}
  <p>Mahsulot yo‘q</p>
  {{/if}}
</div>

<!-- CSS for stars -->
<style>
.rating {
  display: flex;
  gap: 5px;
  margin-top: 5px;
}
.star {
  font-size: 20px;
  color: #ccc;
  transition: 0.2s;
}
.star.active {
  color: gold;
}
.star:hover {
  transform: scale(1.2);
}
</style>

<script>
const evtSource = new EventSource('/events');

evtSource.onmessage = (e) => {
  const data = JSON.parse(e.data);
  const container = document.getElementById('product-row');
  if (!container) return;

  const { products, currentUserId, baseUrl } = data;

  container.innerHTML = products.map((p, i) => `
    <div class="product-card"
      data-id="${p._id}"
      data-serial="${p.serial || ''}"
      data-name="${p.name || ''}"
      data-date="${p.date || ''}"
      data-url="${baseUrl}/products/${p._id}"
      data-rating="${p.rating || 0}">

      <div class="image-wrapper">
        <img src="/uploads/${p.image || 'default.png'}">
      </div>

      <div class="product-info">
        <h3 style="color:#0a7cff;font-weight:bold;">№ ${i + 1}</h3>
        <p>Seriya raqami: <span style="color:red;">${p.serial}</span></p>
        <p>Ro'yxatga oluvchi: <span style="color:red;">${p.name}</span></p>

        <!-- ⭐ RATING -->
        <div class="rating" data-id="${p._id}">
          ${[1,2,3,4,5].map(n => `
            <span class="star ${p.rating >= n ? 'active' : ''}" data-star="${n}">★</span>
          `).join('')}
        </div>

        <div style="display:flex; gap:10px; margin-top:5px;">
          <button class="btn view-btn">🖨 Print</button>

          ${p.user === currentUserId ? `
            <form action="/products/delete/${p._id}" method="post">
              <button class="btn delete-btn">🗑 Delete</button>
            </form>
          ` : ''}
        </div>

        <small>${new Date(p.date).toLocaleDateString('uz-UZ')}</small>
      </div>
    </div>
  `).join('');

  attachEvents();
  initRatings(currentUserId); // currentUserId null bo‘lsa rating disable bo‘ladi
}

// ------------------------
// PRINT FUNCTION
// ------------------------
function attachEvents() {
  document.querySelectorAll('.view-btn').forEach(btn => {
    btn.onclick = () => {
      const cards = Array.from(document.querySelectorAll('.product-card'));
      const w = window.open('', '_blank');
      
      w.document.write(`
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Stickers</title>
<style>
body { margin:0; display:flex; flex-wrap:wrap; gap:10px; padding:10px; font-family:Arial,sans-serif; }
.sticker { width:2.37in; height:1.60in; border:1px solid #000; display:flex; justify-content:space-between; align-items:center; padding:5px; box-sizing:border-box; flex-direction:row; }
.info { font-size:8pt; line-height:1.2; }
.qr { width:96px; height:96px; }
@media print { body { gap:0; padding:0; } .sticker { page-break-inside: avoid; } }
</style>
</head>
<body>
${cards.map(card => {
  const serial = card.dataset.serial || '';
  const name = card.dataset.name || '';
  const date = new Date(card.dataset.date).toLocaleDateString('uz-UZ') || '';
  const url = card.dataset.url || '';
  return `
  <div class="sticker">
    <div class="info">
      <b>Best Tex</b><br>
      Seriya: ${serial}<br>
      Ism: ${name}<br>
      Sana: ${date}
    </div>
    <div class="qr" id="qr-${serial}"></div>
  </div>`;
}).join('')}
<script src="https://cdn.jsdelivr.net/npm/qrcodejs/qrcode.min.js"><\/script>
<script>
${cards.map(card => {
  const serial = card.dataset.serial || '';
  const url = card.dataset.url || '';
  return `new QRCode(document.getElementById("qr-${serial}"), { text: "${url}", width: 96, height: 96 });`;
}).join('')}
window.print();
<\/script>
</body>
</html>
      `);
    }
  });
}

// ------------------------
// ⭐ RATING FUNCTION
// ------------------------
function initRatings(currentUserId) {
  if (!currentUserId) return; // logout bo'lsa click disable

  document.querySelectorAll('.rating').forEach(box => {
    const productId = box.dataset.id

    box.querySelectorAll('.star').forEach(star => {
      star.style.cursor = 'pointer';
      star.onclick = async () => {
        const value = star.dataset.star

        await fetch(`/products/rate/${productId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rating: value })
        })

        box.querySelectorAll('.star').forEach(s => {
          s.classList.toggle('active', s.dataset.star <= value)
        })
      }
    })
  })
}
</script>
