<div id="product-list">
  {{#if products.length}}
  <div class="product-row" id="product-row">
    {{#each products}}
    <div class="product-card"
         data-id="{{_id}}"
         data-serial="{{serial}}"
         data-name="{{name}}"
         data-date="{{date}}"
         data-url="{{baseUrl}}/products/{{_id}}">

      <div class="image-wrapper">
        <img src="/uploads/{{image}}" alt="{{machineName}}">
      </div>

      <div class="product-info">
        <h3 style="color:#0a7cff;font-weight:bold;">№ {{@index}}</h3>
        <p>Seriya raqami: <span style="color:red;">{{serial}}</span></p>
        <p>Ro'yxatga oluvchi: <span style="color:red;">{{name}}</span></p>

        <div style="display:flex; gap:10px;">
          <button class="btn view-btn"><i class="fa-solid fa-print"></i> Print</button>

          {{#ifequal user ../userId}}
          <div style="display:flex; gap:10px;">
            <div class="comment" data-id="{{_id}}">
              <span class="comment-text">{{comment}}</span>
              <button class="edit-comment-btn"><i class="fa-regular fa-pen-to-square fa-fade"></i>Edit</button>
            </div>
            <form action="/products/delete/{{_id}}" method="post">
              <button class="btn delete-btn"><i class="fa-solid fa-trash-can fa-beat-fade"></i>Delete</button>
            </form>
          </div>
          {{/ifequal}}
        </div>

        <small>{{formatDate date}}</small>
      </div>
    </div>
    {{/each}}
  </div>
  {{else}}
  <p>Mahsulot yo‘q</p>
  {{/if}}
</div>

<script>
const evtSource = new EventSource('/events');

evtSource.onmessage = (e) => {
  const data = JSON.parse(e.data);
  const container = document.getElementById('product-row');
  if (!container) return;

  const { products, currentUserId, baseUrl } = data;

  container.innerHTML = products.map((p, i) => `
    <div class="product-card"
      data-id="${p._id}"
      data-serial="${p.serial || ''}"
      data-name="${p.name || ''}"
      data-date="${p.date || ''}"
      data-url="${baseUrl}/products/${p._id}">

      <div class="image-wrapper">
        <img src="/uploads/${p.image || 'default.png'}">
      </div>

      <div class="product-info">
        <h3 style="color:#0a7cff;font-weight:bold;">№ ${i + 1}</h3>
        <p>Seriya raqami: <span style="color:red;">${p.serial}</span></p>
        <p>Ro'yxatga oluvchi: <span style="color:red;">${p.name}</span></p>

        <div style="display:flex; gap:10px;">
          <button class="btn view-btn">🖨 Print</button>

          ${p.user === currentUserId ? `
            <form action="/products/delete/${p._id}" method="post">
              <button class="btn delete-btn">🗑 Delete</button>
            </form>
          ` : ''}
        </div>

        <small>${new Date(p.date).toLocaleDateString('uz-UZ')}</small>
      </div>
    </div>
  `).join('');

  attachEvents();
}

function attachEvents() {
  document.querySelectorAll('.view-btn').forEach(btn => {
    btn.onclick = () => {
      const cards = Array.from(document.querySelectorAll('.product-card'));
      const w = window.open('', '_blank');
      
      w.document.write(`
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Stickers</title>
<style>
body {
  margin:0;
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  padding:10px;
  font-family:Arial,sans-serif;
}
.sticker {
  width:2.37in;
  height:1.60in;
  border:1px solid #000;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:5px;
  box-sizing:border-box;
  flex-direction:row;
}
.info {
  font-size:8pt;
  line-height:1.2;
}
.qr {
  width:96px;
  height:96px;
}
@media print {
  body { gap:0; padding:0; }
  .sticker { page-break-inside: avoid; }
}
</style>
</head>
<body>
${cards.map(card => {
  const serial = card.dataset.serial || '';
  const name = card.dataset.name || '';
  const date = new Date(card.dataset.date).toLocaleDateString('uz-UZ') || '';
  const url = card.dataset.url || '';
  return `
  <div class="sticker">
    <div class="info">
      <b>Best Tex</b><br>
      Seriya: ${serial}<br>
      Ism: ${name}<br>
      Sana: ${date}
    </div>
    <div class="qr" id="qr-${serial}"></div>
  </div>`;
}).join('')}
<script src="https://cdn.jsdelivr.net/npm/qrcodejs/qrcode.min.js"><\/script>
<script>
${cards.map(card => {
  const serial = card.dataset.serial || '';
  const url = card.dataset.url || '';
  return `new QRCode(document.getElementById("qr-${serial}"), { text: "${url}", width: 96, height: 96 });`;
}).join('')}
window.print();
<\/script>
</body>
</html>
      `);
    }
  });
}
</script>
