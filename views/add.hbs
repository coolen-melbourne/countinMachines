<form class="modern-form" action="/add" method="POST" enctype="multipart/form-data">
  <h2>Yangi mashina qo'shish</h2>

  {{#if erroAddPath}}
  <div role="alert">{{erroAddPath}}</div>
  {{/if}}

  <div class="form-group">
    <label>Rasm</label>
    <input type="file" name="image" required />
  </div>

  <div class="form-group">
    <label>Sana</label>
    <input type="date" name="date" required />
  </div>

  <div class="form-group">
    <label>Ism Familya</label>
    <input type="text" name="name" required />
  </div>

  <div class="form-group">
    <label>Tikuv mashina</label>
    <input type="text" name="serial" placeholder="Jack" required />
  </div>

  <div class="form-group">
    <label>Model raqami</label>
    <input type="text" name="serial" placeholder="JK-T1377E" required />
  </div>

  <div class="form-group">
    <label>Seriya raqami</label>
    <input type="text" name="serial" placeholder="23043502" required />
  </div>

  <button type="submit">Saqlash</button>
</form>
